% Generalized 1D Poisson-Schrodinger Solver for Arbitrary GaN/AlGaN Stacks
function [z_out, Ec_out, n_out] = Run_GaN_HEMT(input_layers)
    clear; clc; close all;
    
    global aquila_control
    aquila_control.verbose = 0; % Set to 0 to silence output, 1 for details
    
    %% 1. DEFINE GENERIC LAYER SCHEMA & GLOBALS
    % Substrate lattice reference (Assume thick relaxed GaN buffer underneath)
    a_substrate = 3.189; % Angstroms (GaN)
    dz = 2.5;            % GRID SPACING in Angstroms
    
    % Define Epitaxial Stack (from Surface -> Down to Bulk)
    layers = cell2mat(input_layers);
    
    %% 2. DYNAMIC DOMAIN ASSEMBLY
    % Initialize unified global arrays
    z = []; Ec = []; Ev = []; eps_r = []; meff = []; Nd = []; P_total = [];
    interface_nodes = [];
    current_z = 0;
    
    % Reference GaN Bandgap for Conduction Band Offset calculation (Delta Ec)
    [Eg_ref, ~, ~, ~, ~] = ganmaterial(0);
    
    fprintf('Assembling Epitaxial Stack...\n');
    for i = 1:length(layers)
        L = layers(i);
        
        % Fetch material parameters
        [Eg_L, eps_L, m_L, Psp_L, Ppz_coeff_L] = ganmaterial(L.Al_x);
        
        % Build spatial grid for this layer
        if i == 1
            z_layer = (0 : dz : L.thickness)';
        else
            % Avoid duplicating the interface node by starting at current_z + dz
            z_layer = (current_z + dz : dz : current_z + L.thickness)';
        end
        N_layer = length(z_layer);
        
        % Calculate Strain and Polarization
        a_layer = 3.1986 - 0.0891 * L.Al_x; % From user's original parameterization
        strain = (a_substrate - a_layer) / a_layer;
        P_pz = Ppz_coeff_L * strain;
        
        % Calculate Band Edges (Assume 70/30 split for dEc/dEv relative to GaN)
        dEc = 0.7 * (Eg_L - Eg_ref);
        Ec_layer = ones(N_layer, 1) * dEc;
        Ev_layer = Ec_layer - (ones(N_layer, 1) * Eg_L);
        
        % Populate localized arrays
        eps_layer  = ones(N_layer, 1) * eps_L;
        meff_layer = ones(N_layer, 1) * m_L;
        Nd_layer   = ones(N_layer, 1) * (L.Nd_val - L.N_trap);
        P_layer    = ones(N_layer, 1) * (Psp_L + P_pz);
        
        % Concatenate into unified domain
        z       = [z; z_layer];
        Ec      = [Ec; Ec_layer];
        Ev      = [Ev; Ev_layer];
        eps_r   = [eps_r; eps_layer];
        meff    = [meff; meff_layer];
        Nd      = [Nd; Nd_layer];
        P_total = [P_total; P_layer];
        
        % Track interfaces for polarization charge spikes
        current_z = current_z + L.thickness;
        if i < length(layers)
            interface_nodes = [interface_nodes; length(z)];
        end
    end
    N = length(z);
    
    %% 3. MULTI-JUNCTION POLARIZATION SPIKES
    rho_pol = zeros(N, 1);
    unit_conv = 0.062415; % C/m^2 to e/A^2
    
    for idx = interface_nodes'
        % Interface charge = divergence of Polarization
        sigma_int = P_total(idx+1) - P_total(idx); 
        rho_pol(idx) = (sigma_int * unit_conv) / dz; 
    end
    
    %% 4. SELF-CONSISTENT LOOP (POISSON-SCHRODINGER)
    phi = zeros(N, 1);           
    n_conc = zeros(N, 1);        
    damping = 0.1;              
    kT = 0.0259; % eV (Room Temp)
    
    % Convert Doping to e/A^3 (1 cm^-3 = 1e-24 A^-3)
    Nd = Nd * 1e-24; 
    
    num_subbands = 10; % Bumped to 10 to ensure deep AlN well states are captured
    
    fprintf('Starting Solver Loop...\n');
    for iter = 1:100
        % --- A. POISSON EQUATION ---
        A = sparse(N, N);
        b = zeros(N, 1);
        
        for i = 2:N-1
            e_avg = 0.5 * (eps_r(i) + eps_r(i+1));
            e_avg_m = 0.5 * (eps_r(i) + eps_r(i-1));
            
            A(i,i)   = -(e_avg + e_avg_m);
            A(i,i+1) = e_avg;
            A(i,i-1) = e_avg_m;
            
            const = 180.95; % CORRECTED: q/eps0 in V*A
            total_rho = Nd(i) - n_conc(i) + rho_pol(i);
            b(i) = -total_rho * dz^2 * const;
        end
        
        % Boundary Conditions
        A(1,1) = 1; b(1) = -0.5; % Lowered Schottky pinning for the GaN Cap
        A(N,N) = 1; A(N,N-1) = -1; b(N) = 0; % Neumann BC (Flat band in bulk)
        
        phi_new = A \ b;
        phi = (1-damping)*phi + damping*phi_new;
        
        % --- B. SCHRODINGER EQUATION ---
        diags = genmatrix1D(Ec - phi, z', meff);
        
        main_diag  = diags(:,1);
        super_diag = diags(:,2);
        len = length(main_diag);
        
        lower_diag = [0; super_diag(1:end-1)];
        H_sparse = spdiags([lower_diag, main_diag, super_diag], -1:1, len, len);
        
        % FIX 1: Use 'sa' (Smallest Algebraic) to find deep ground states
        % [psi_internal, E_eig] = eigs(H_sparse, num_subbands, 'sa');
        sigma = min(Ec - phi) - 0.1; % Shift slightly below the minimum potential
        [psi_internal, E_eig] = eigs(H_sparse, num_subbands, sigma);
        E_vals = diag(E_eig);
        
        psi = zeros(N, num_subbands);
        psi(2:end-1, :) = psi_internal;
        
        % --- C. UPDATE DENSITY ---
        n_new = zeros(N,1);
        Ef = 0; 
        
        [~, max_idx] = max(psi(:,1));
        meff_well = meff(max_idx);
        
        for k = 1:num_subbands
            arg = (Ef - E_vals(k))/kT;
            
            % FIX 3: Numerically stable Fermi-Dirac integral prevents 'Inf' crash
            occ = max(arg, 0) + log(1 + exp(-abs(arg)));
            
            % FIX 2: Correct unit conversion from cm^-2 to A^-2 (1e-16)
            prefactor = (meff_well * 4.17e14 * 1e-16) * kT; 
            
            Ns = prefactor * occ;
            psi_norm = psi(:,k).^2 / (sum(psi(:,k).^2)*dz);
            n_new = n_new + Ns * psi_norm;
        end
        
        n_conc = (1-damping)*n_conc + damping*n_new;
    
        y = n_conc*1e24;
        area = cumtrapz(z*1e-8, y);
        ns = area(end);
        
        % --- PLOTTING ---
        if mod(iter, 5) == 0
            figure(1);
            plot(z, Ec - phi, 'b', 'LineWidth', 2); hold on;
            plot(z, Ev - phi, 'g', 'LineWidth', 2); 
            plot(z, -phi, 'k--');
            plot([min(z), max(z)], [0, 0], 'r:'); 
            ylabel('Energy (eV)'); xlabel('Depth (A)'); 
            title(['Band Diagram - Iteration: ' num2str(iter)]);
            legend('Ec', 'Ev', 'Potential', 'Ef', 'Location', 'best');
            hold off;
            
            figure(2);
            plot(z, n_conc*1e24, 'r', 'LineWidth', 2);
            ylabel('Density (cm^{-3})'); xlabel('Depth (A)');
            title(sprintf('Electron Density - Iteration: %d | n_s: %.4f \\times 10^{13} cm^{-2}', iter, ns/1e13));
    
    
            drawnow;
        end
    end
end
fprintf('Solver Complete.\n');